# LexiLaw Backend Configuration (.env.example)
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# NLP Model Configuration
SPACY_MODEL=en_core_web_sm
SEMANTIC_MODEL_NAME_OR_PATH=all-MiniLM-L6-v2
DISABLE_SEMANTIC_MODEL=false

# System Limits
MAX_TEXT_LENGTH=20000
MAX_TOP_K=20
DEFAULT_TOP_K=5
MAX_PDF_SIZE_BYTES=10485760
MAX_PDF_PAGES=50
